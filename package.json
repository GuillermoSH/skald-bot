{
  "name": "skald",
  "version": "0.1.0",
  "private": true,
  "description": "Skald: bot de Discord de consulta y avisos para un servidor de Minecraft Java",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "register": "tsx --env-file-if-exists=.env src/register.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "art": "tsx scripts/art/generate.ts"
  },
  "dependencies": {
    "discord.js": "14.28.1",
    "minecraft-server-util": "5.4.4",
    "rcon-client": "4.2.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
