# Copia este fichero a .env y rellénalo. El .env real NO se sube a git.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
ALERT_CHANNEL_ID=
# Qué avisar (por defecto, todo): join,leave,death,advancement,server
ALERT_EVENTS=join,leave,death,advancement,server
# Opcional: un canal distinto para un tipo de aviso (si no, va a ALERT_CHANNEL_ID)
ALERT_CHANNEL_JOIN=
ALERT_CHANNEL_LEAVE=
ALERT_CHANNEL_DEATH=
ALERT_CHANNEL_ADVANCEMENT=
ALERT_CHANNEL_SERVER=
# Canales donde se pueden usar los comandos, separados por comas (vacío = en todos).
# El canal de administración (ADMIN_CHANNEL_ID) siempre está permitido.
COMMAND_CHANNEL_IDS=
# IDs de usuario de Discord de los administradores (separados por comas).
# El primero aparece en las runas como la persona a la que escribir para entrar.
ADMIN_USER_IDS=

# --- Administración ---
# Canal privado para admins y colaboradores: avisos de copias de seguridad que fallan
ADMIN_CHANNEL_ID=
# Horas sin copia nueva antes de avisar (mc-backup hace una cada noche)
BACKUP_MAX_AGE_HOURS=26

# --- Heraldo (requiere el «Server Members Intent» activado en el portal) ---
# Canal de bienvenidas, despedidas y boosts
HERALD_CHANNEL_ID=
# Canal de normas: Skald publica y mantiene ahí el mensaje de las runas
RULES_CHANNEL_ID=
# Rol que Skald da automáticamente a quien entra (Skald debe estar por encima en la lista de roles)
AUTO_ROLE_ID=
# Dirección del servidor de Minecraft que se muestra en las runas (opcional)
MC_PUBLIC_ADDRESS=

# --- Servidor de Minecraft ---
# Dentro del compose del Minecraft, el host es el nombre del servicio
MC_HOST=minecraft
MC_PORT=25565
RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=

# --- Mapa (BlueMap) ---
# Opcional. Enlace que da /mapa, por ejemplo http://192.168.1.50:8100
BLUEMAP_URL=

# --- Rutas (dentro del contenedor del bot, montadas en solo lectura) ---
DATA_DIR=/data
BACKUPS_DIR=/backups
# Estado propio de Skald (lo único escribible; en Docker, un volumen aparte)
STATE_DIR=/state

# --- Temporadas y economía ---
# Zona horaria para «el día» (topes diarios de monedas), p. ej. Europe/Madrid
TIMEZONE=UTC
# Monedas que se ganan jugando: true | false
ECONOMY_ENABLED=false

# --- Varios ---
# debug | info | warn | error
LOG_LEVEL=info
