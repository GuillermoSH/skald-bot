# Copia este fichero a .env y rellénalo. El .env real NO se sube a git.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
ALERT_CHANNEL_ID=
# IDs de usuario de Discord con permiso para comandos que escriben (separados por comas)
ADMIN_USER_IDS=

# --- Servidor de Minecraft ---
# Dentro del compose del Minecraft, el host es el nombre del servicio
MC_HOST=minecraft
MC_PORT=25565
RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=

# --- Mapa (BlueMap) ---
# Opcional. Enlace que da /mapa, por ejemplo http://192.168.1.50:8100
BLUEMAP_URL=

# --- Rutas (dentro del contenedor del bot, montadas en solo lectura) ---
DATA_DIR=/data
BACKUPS_DIR=/backups

# --- Varios ---
# debug | info | warn | error
LOG_LEVEL=info
